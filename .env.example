# Copy to .env.local and fill in real values. Never commit real secrets.
# All variables are required; src/lib/env.ts validates them on first use.

# Supabase project URL (https)
SUPABASE_URL=https://your-project.supabase.co
# Service role key: server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Shared HMAC secret for onboarding webhooks, at least 32 characters
# (e.g. `openssl rand -hex 32`)
WEBHOOK_SECRET=
# Slack Incoming Webhook URL (https)
SLACK_WEBHOOK_URL=
# Bearer token Vercel Cron sends to /api/cron/stuck-creators, at least 32 characters
CRON_SECRET=
